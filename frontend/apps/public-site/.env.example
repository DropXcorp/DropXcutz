# One deployment serves EVERY salon website — the salon is chosen from the visitor's domain.
# Public URL of the DropXcutz API, ending in /api (used by visitors' browsers for booking).
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Optional private API URL for server-side rendering (defaults to NEXT_PUBLIC_API_URL).
# API_URL=http://localhost:5000/api
# Must equal PUBLIC_SITE_REVALIDATE_SECRET on the API server.
REVALIDATE_SECRET=

# Local development: open http://localhost:3002/?salon=<slug> (or http://<slug>.localhost:3002).
