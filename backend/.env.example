# Server (optional; defaults are shown)
PORT_NO=5000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
# Cookie defaults work for same-site app/API deployments. For a cross-site frontend,
# set COOKIE_SAME_SITE=None and COOKIE_SECURE=true. COOKIE_DOMAIN is optional.
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# PostgreSQL (required)
# Local Docker default. Keep these values in sync with ../.env.docker.
DATABASE_URL=postgresql://dropxcutz:dropxcutz_dev_password@localhost:5432/dropxcutz

# Required for the super-admin application. Keep this server-only.
SUPER_ADMIN_API_KEY=replace-with-a-long-random-api-key

# Local development only: used when x-salon-code is not supplied.
DEFAULT_SALON_CODE=dropx-studio
# Required: use a long random value (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret

# One-time platform administrator bootstrap. Remove after the account is created.
PLATFORM_ADMIN_NAME=Platform Administrator
PLATFORM_ADMIN_EMAIL=owner@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password

# Razorpay platform billing. Keep all values server-side; do not expose them as
# NEXT_PUBLIC variables. Razorpay itself never emails/SMSes the payment link
# (notify.email/sms are disabled); the platform now sends its own invoice email
# instead — see SMTP_* below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required when salons connect their own Razorpay accounts. Generate a random
# 32-byte base64 value; it encrypts each salon's key secret and webhook secret.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
# Persistent upload location. Mount this path as a volume in container deployments.
UPLOAD_DIR=uploads

# Transactional email (welcome emails, invoices, trial/subscription reminders).
# Works with any SMTP provider (Gmail app password, SendGrid, Postmark, etc).
# Leave unset to disable email sending; affected flows log a warning and continue.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public URL of the salon-erp app, used in welcome emails so new admins know
# where to log in.
SALON_ERP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Salon websites & booking automation
# ---------------------------------------------------------------------------
# Your main public domain. Published template sites are served at
# https://<salon-slug>.<PUBLIC_ROOT_DOMAIN> (needs ONE wildcard DNS record: *.yourdomain.com).
PUBLIC_ROOT_DOMAIN=
# Base URL of the multi-tenant public-site app (used for links in emails when a salon has no root domain).
PUBLIC_SITE_URL=http://localhost:3002
# Lets the API tell the public site to refresh instantly when a salon publishes.
# Same secret must be set as REVALIDATE_SECRET in the public-site app.
PUBLIC_SITE_REVALIDATE_URL=http://localhost:3002/api/revalidate
PUBLIC_SITE_REVALIDATE_SECRET=
# Public HTTPS URL of THIS API (no trailing slash). Shown to salons as their Razorpay webhook URL.
API_PUBLIC_URL=http://localhost:5000
# Optional: attach salons' custom domains to your Vercel project automatically (free SSL).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Minutes an unpaid online booking holds its slot before being released (5-120).
BOOKING_HOLD_MINUTES=15
# Key rotation: move the old PAYMENT_CREDENTIALS_ENCRYPTION_KEY here when you set a new one.
# PAYMENT_CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
