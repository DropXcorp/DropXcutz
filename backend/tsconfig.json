{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/index.ts",
    "src/config/prisma.ts",
    "src/controllers/**/*.ts",
    "src/middleware/**/*.ts",
    "src/routes/**/*.ts",
    "src/services/**/*.ts",
    "src/modules/**/*.ts",
    "src/validators/**/*.ts",
    "prisma/seed.ts"
  ]
}
