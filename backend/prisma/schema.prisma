generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  SALON_ADMIN
  STAFF
}

enum SalonStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipTier {
  STANDARD
  SILVER
  GOLD
}

enum AppointmentSource {
  WALK_IN
  ONLINE
  PHONE
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PayrollStatus {
  DRAFT
  PAID
}

enum LoyaltyEntryType {
  EARN
  REDEEM
  ADJUSTMENT
}

enum NotificationType {
  APPOINTMENT
  LOW_STOCK
  PAYMENT
  SYSTEM
}

model Salon {
  id                      String          @id @default(cuid())
  code                    String          @unique @db.VarChar(60)
  salonName               String          @db.VarChar(160)
  legalName               String          @db.VarChar(200)
  gstin                   String?         @db.VarChar(20)
  logoUrl                 String?
  phone                   String          @db.VarChar(30)
  email                   String?          @db.VarChar(200)
  website                 String?
  address                 String?
  city                    String?         @db.VarChar(100)
  state                   String?         @db.VarChar(100)
  postalCode              String?         @db.VarChar(20)
  currency                String          @default("INR") @db.VarChar(3)
  locale                  String          @default("en-IN") @db.VarChar(20)
  timezone                String          @default("Asia/Kolkata") @db.VarChar(80)
  taxRate                 Decimal         @default(18) @db.Decimal(5, 2)
  invoicePrefix           String          @default("INV") @db.VarChar(12)
  openingTime             String          @default("09:00") @db.VarChar(5)
  closingTime             String          @default("20:00") @db.VarChar(5)
  appointmentSlotMinutes  Int             @default(30)
  cancellationWindowHours Int             @default(4)
  allowOnlineBooking      Boolean         @default(true)
  adminName               String          @db.VarChar(160)
  adminEmail              String          @db.VarChar(200)
  lowStockAlerts          Boolean         @default(true)
  dailyRevenueDigest      Boolean         @default(true)
  status                  SalonStatus     @default(TRIAL)
  subscriptionPlan        String          @default("Starter") @db.VarChar(60)
  trialEndsAt             DateTime?
  nextAppointmentNumber   Int             @default(1001)
  nextInvoiceNumber       Int             @default(1)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  customers               Customer[]
  employees               Employee[]
  services                Service[]
  inventoryItems          InventoryItem[]
  appointments            Appointment[]
  invoices                Invoice[]
  payrollRuns             PayrollRun[]
  loyaltyEntries          LoyaltyEntry[]
  notifications           Notification[]
  users                   User[]

  @@index([status])
}

model Customer {
  id             String         @id @default(cuid())
  salonId      String
  name           String         @db.VarChar(160)
  phone          String         @db.VarChar(30)
  email          String?        @db.VarChar(200)
  membership     MembershipTier @default(STANDARD)
  points         Int            @default(0)
  totalSpend     Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  salon          Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  invoices       Invoice[]
  loyaltyEntries LoyaltyEntry[]

  @@unique([salonId, phone])
  @@index([salonId, name])
}

model Employee {
  id             String        @id @default(cuid())
  salonId      String
  name           String        @db.VarChar(160)
  role           String        @db.VarChar(100)
  phone          String        @db.VarChar(30)
  email          String?       @db.VarChar(200)
  baseSalary     Decimal       @default(0) @db.Decimal(12, 2)
  commissionRate Decimal       @default(10) @db.Decimal(5, 2)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  salon          Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  payrollRuns    PayrollRun[]

  @@unique([salonId, phone])
  @@index([salonId, active])
}

model InventoryItem {
  id           String    @id @default(cuid())
  salonId      String
  name         String    @db.VarChar(160)
  sku          String    @db.VarChar(80)
  stock        Int       @default(0)
  reorderLevel Int       @default(0)
  unitCost     Decimal   @default(0) @db.Decimal(12, 2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  salon        Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services     Service[]

  @@unique([salonId, sku])
  @@index([salonId, active])
}

model Service {
  id                String            @id @default(cuid())
  salonId      String
  name              String            @db.VarChar(160)
  description       String?
  price             Decimal           @db.Decimal(12, 2)
  durationMinutes   Int
  inventoryItemId   String?
  inventoryQuantity Int               @default(1)
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  salon             Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem?    @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  appointmentLines  AppointmentLine[]

  @@unique([salonId, name])
  @@index([salonId, active])
}

model Appointment {
  id                String            @id @default(cuid())
  salonId      String
  appointmentNumber String            @db.VarChar(40)
  customerId        String
  employeeId        String?
  source            AppointmentSource @default(WALK_IN)
  scheduledAt       DateTime
  durationMinutes   Int
  subtotal          Decimal           @db.Decimal(12, 2)
  taxAmount         Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @db.Decimal(12, 2)
  amountPaid        Decimal           @default(0) @db.Decimal(12, 2)
  paymentStatus     PaymentStatus     @default(PENDING)
  status            AppointmentStatus @default(BOOKED)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  salon             Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  employee          Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  lines             AppointmentLine[]
  invoices          Invoice[]

  @@unique([salonId, appointmentNumber])
  @@index([salonId, scheduledAt])
  @@index([salonId, status])
  @@index([customerId])
  @@index([employeeId])
}

model AppointmentLine {
  id              String      @id @default(cuid())
  appointmentId   String
  serviceId       String
  serviceName     String      @db.VarChar(160)
  unitPrice       Decimal     @db.Decimal(12, 2)
  durationMinutes Int
  quantity        Int         @default(1)
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

model Invoice {
  id            String        @id @default(cuid())
  salonId      String
  invoiceNumber String        @db.VarChar(40)
  customerId    String
  appointmentId String?
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([salonId, invoiceNumber])
  @@index([salonId, issuedAt])
  @@index([customerId])
}

model PayrollRun {
  id         String        @id @default(cuid())
  salonId      String
  employeeId String
  month      String        @db.VarChar(7)
  baseSalary Decimal       @db.Decimal(12, 2)
  commission Decimal       @default(0) @db.Decimal(12, 2)
  deductions Decimal       @default(0) @db.Decimal(12, 2)
  status     PayrollStatus @default(DRAFT)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  salon      Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([salonId, employeeId, month])
  @@index([salonId, month])
}

model LoyaltyEntry {
  id          String           @id @default(cuid())
  salonId      String
  customerId  String
  type        LoyaltyEntryType
  points      Int
  description String?
  createdAt   DateTime         @default(now())
  salon       Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([salonId, createdAt])
  @@index([customerId])
}

model Notification {
  id        String           @id @default(cuid())
  salonId      String
  type      NotificationType
  title     String           @db.VarChar(160)
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  salon     Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, readAt, createdAt])
}

model User {
  id           String   @id @default(cuid())
  salonId      String?
  name         String   @db.VarChar(160)
  email        String?   @unique @db.VarChar(200)
  passwordHash String
  role         UserRole @default(SALON_ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  salon        Salon?   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@index([salonId, active])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
model PlatformAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(100)
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model PlatformSettings {
  id                    String   @id @default("platform")
  platformName          String   @default("DropXCutz Platform") @db.VarChar(160)
  supportEmail          String?  @db.VarChar(200)
  defaultTrialDays      Int      @default(14)
  sessionHours          Int      @default(8)
  passwordMinimumLength Int      @default(12)
  updatedAt             DateTime @updatedAt
}
