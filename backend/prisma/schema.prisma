generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  SALON_ADMIN
  STAFF
}

enum SalonStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipTier {
  STANDARD
  SILVER
  GOLD
}

enum AppointmentSource {
  ERP
  WALK_IN
  WEBSITE
  PHONE
  WHATSAPP
}

enum WebsiteType {
  NONE
  TEMPLATE
  CUSTOM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum PlatformInvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
  REFUNDED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_SALON
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BulkOperationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PayrollStatus {
  DRAFT
  PAID
}

enum LoyaltyEntryType {
  EARN
  REDEEM
  ADJUSTMENT
}

enum NotificationType {
  APPOINTMENT
  LOW_STOCK
  PAYMENT
  SYSTEM
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  SALARY
  ELECTRICITY
  INTERNET
  MARKETING
  CLEANING
  MISCELLANEOUS
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  ONLINE
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Salon {
  id                      String                @id @default(cuid())
  code                    String                @unique @db.VarChar(60)
  slug                    String                @unique @db.VarChar(60)
  salonName               String                @db.VarChar(160)
  legalName               String                @db.VarChar(200)
  gstin                   String?               @db.VarChar(20)
  logoUrl                 String?
  phone                   String                @db.VarChar(30)
  email                   String?               @db.VarChar(200)
  website                 String?
  address                 String?
  city                    String?               @db.VarChar(100)
  state                   String?               @db.VarChar(100)
  postalCode              String?               @db.VarChar(20)
  currency                String                @default("INR") @db.VarChar(3)
  locale                  String                @default("en-IN") @db.VarChar(20)
  timezone                String                @default("Asia/Kolkata") @db.VarChar(80)
  taxRate                 Decimal               @default(18) @db.Decimal(5, 2)
  invoicePrefix           String                @default("INV") @db.VarChar(12)
  openingTime             String                @default("09:00") @db.VarChar(5)
  closingTime             String                @default("20:00") @db.VarChar(5)
  appointmentSlotMinutes  Int                   @default(30)
  cancellationWindowHours Int                   @default(4)
  allowOnlineBooking      Boolean               @default(true)
  adminName               String                @db.VarChar(160)
  adminEmail              String                @db.VarChar(200)
  lowStockAlerts          Boolean               @default(true)
  dailyRevenueDigest      Boolean               @default(true)
  status                  SalonStatus           @default(TRIAL)
  archivedAt              DateTime?
  subscriptionPlan        String                @default("Starter") @db.VarChar(60)
  planId                  String?
  trialEndsAt             DateTime?
  nextAppointmentNumber   Int                   @default(1001)
  nextInvoiceNumber       Int                   @default(1)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  customers               Customer[]
  employees               Employee[]
  services                Service[]
  inventoryItems          InventoryItem[]
  appointments            Appointment[]
  invoices                Invoice[]
  payrollRuns             PayrollRun[]
  loyaltyEntries          LoyaltyEntry[]
  notifications           Notification[]
  users                   User[]
  branches                Branch[]
  serviceCategories       ServiceCategory[]
  suppliers               Supplier[]
  purchaseOrders          PurchaseOrder[]
  expenses                Expense[]
  membershipPlans         MembershipPlan[]
  packages                Package[]
  reviews                 Review[]
  coupons                 Coupon[]
  galleryImages           GalleryImage[]
  offers                  Offer[]
  salonSettings           SalonSettings?
  salonAuditLogs          SalonAuditLog[]
  integrations            SalonIntegration[]
  plan                    Plan?                 @relation("SalonPlan", fields: [planId], references: [id], onDelete: SetNull)
  subscriptions           Subscription[]
  platformInvoices        PlatformInvoice[]
  supportTickets          SupportTicket[]
  trialReminders          TrialReminder[]
  salonFeatures           SalonFeature[]
  websiteSettings         SalonWebsiteSettings?

  @@index([status])
  @@index([planId])
}

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique @db.VarChar(60)
  name          String         @unique @db.VarChar(100)
  description   String?
  monthlyPrice  Decimal?       @db.Decimal(12, 2)
  annualPrice   Decimal?       @db.Decimal(12, 2)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  salons        Salon[]        @relation("SalonPlan")
  features      PlanFeature[]
  subscriptions Subscription[]
}

model Feature {
  id          String         @id @default(cuid())
  code        String         @unique @db.VarChar(80)
  name        String         @db.VarChar(120)
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  plans       PlanFeature[]
  salons      SalonFeature[]
}

model PlanFeature {
  planId    String
  featureId String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
}

model SalonFeature {
  salonId   String
  featureId String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([salonId, featureId])
  @@index([featureId])
}

model Subscription {
  id                     String             @id @default(cuid())
  salonId                String
  planId                 String
  status                 SubscriptionStatus @default(TRIAL)
  startsAt               DateTime           @default(now())
  expiresAt              DateTime?
  monthlyPrice           Decimal?           @db.Decimal(12, 2)
  annualPrice            Decimal?           @db.Decimal(12, 2)
  razorpayPlanId         String?            @unique @db.VarChar(80)
  razorpaySubscriptionId String?            @unique @db.VarChar(80)
  billingCycle           String?            @db.VarChar(20)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  salon                  Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  platformInvoices       PlatformInvoice[]

  @@index([salonId, status])
  @@index([planId])
}

model PlatformInvoice {
  id                    String                @id @default(cuid())
  salonId               String
  subscriptionId        String?
  invoiceNumber         String                @unique @db.VarChar(40)
  status                PlatformInvoiceStatus @default(DRAFT)
  subtotal              Decimal               @db.Decimal(12, 2)
  taxAmount             Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal               @db.Decimal(12, 2)
  amountPaid            Decimal               @default(0) @db.Decimal(12, 2)
  currency              String                @default("INR") @db.VarChar(3)
  dueAt                 DateTime?
  paidAt                DateTime?
  razorpayPaymentLinkId String?               @unique @db.VarChar(80)
  razorpayPaymentId     String?               @unique @db.VarChar(80)
  paymentUrl            String?
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  salon                 Salon                 @relation(fields: [salonId], references: [id], onDelete: Cascade)
  subscription          Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([salonId, status, dueAt])
  @@index([subscriptionId])
}

model RazorpayWebhookEvent {
  id              String    @id @default(cuid())
  eventId         String    @unique @db.VarChar(100)
  eventType       String    @db.VarChar(100)
  payload         Json
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime  @default(now())

  @@index([eventType, createdAt])
}

model SalonWebsiteSettings {
  id           String      @id @default(cuid())
  salonId      String      @unique
  type         WebsiteType @default(NONE)
  title        String?     @db.VarChar(160)
  description  String?
  customDomain String?     @db.VarChar(253)
  theme        Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  salon        Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model Customer {
  id               String          @id @default(cuid())
  salonId          String
  name             String          @db.VarChar(160)
  phone            String          @db.VarChar(30)
  email            String?         @db.VarChar(200)
  membership       MembershipTier  @default(STANDARD)
  points           Int             @default(0)
  totalSpend       Decimal         @default(0) @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  salon            Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  invoices         Invoice[]
  loyaltyEntries   LoyaltyEntry[]
  membershipPlanId String?
  membershipPlan   MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  payments         Payment[]
  reviews          Review[]

  @@unique([salonId, phone])
  @@index([salonId, name])
}

model Employee {
  id               String            @id @default(cuid())
  salonId          String
  name             String            @db.VarChar(160)
  role             String            @db.VarChar(100)
  phone            String            @db.VarChar(30)
  email            String?           @db.VarChar(200)
  baseSalary       Decimal           @default(0) @db.Decimal(12, 2)
  commissionRate   Decimal           @default(10) @db.Decimal(5, 2)
  active           Boolean           @default(true)
  isBookable       Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  salon            Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  payrollRuns      PayrollRun[]
  branchId         String?
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  commissions      Commission[]
  employeeServices EmployeeService[]
  reviews          Review[]

  @@unique([salonId, phone])
  @@index([salonId, active])
  @@index([branchId])
}

model InventoryItem {
  id                 String              @id @default(cuid())
  salonId            String
  name               String              @db.VarChar(160)
  sku                String              @db.VarChar(80)
  stock              Int                 @default(0)
  reorderLevel       Int                 @default(0)
  unitCost           Decimal             @default(0) @db.Decimal(12, 2)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  salon              Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services           Service[]
  purchaseOrderItems PurchaseOrderItem[]
  branchId           String?
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([salonId, sku])
  @@index([salonId, active])
  @@index([branchId])
}

model Service {
  id                String            @id @default(cuid())
  salonId           String
  name              String            @db.VarChar(160)
  description       String?
  price             Decimal           @db.Decimal(12, 2)
  durationMinutes   Int
  inventoryItemId   String?
  inventoryQuantity Int               @default(1)
  active            Boolean           @default(true)
  isPublic          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  salon             Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          ServiceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryItem     InventoryItem?    @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  appointmentLines  AppointmentLine[]
  employeeServices  EmployeeService[]
  packageServices   PackageService[]

  @@unique([salonId, name])
  @@index([salonId, active])
}

model Appointment {
  id                String            @id @default(cuid())
  salonId           String
  appointmentNumber String            @db.VarChar(40)
  customerId        String
  employeeId        String?
  branchId          String?
  timeSlotId        String?
  source            AppointmentSource @default(WALK_IN)
  websiteRequestId  String?           @db.VarChar(100)
  scheduledAt       DateTime
  durationMinutes   Int
  subtotal          Decimal           @db.Decimal(12, 2)
  taxAmount         Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @db.Decimal(12, 2)
  amountPaid        Decimal           @default(0) @db.Decimal(12, 2)
  paymentStatus     PaymentStatus     @default(PENDING)
  status            AppointmentStatus @default(BOOKED)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  salon             Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  employee          Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  timeSlot          TimeSlot?         @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  lines             AppointmentLine[]
  invoices          Invoice[]
  commissions       Commission[]
  payments          Payment[]
  reviews           Review[]

  @@unique([salonId, appointmentNumber])
  @@unique([salonId, websiteRequestId])
  @@index([salonId, scheduledAt])
  @@index([salonId, status])
  @@index([customerId])
  @@index([employeeId])
  @@index([branchId])
  @@index([timeSlotId])
}

model SalonIntegration {
  id             String   @id @default(cuid())
  salonId        String
  publicKey      String   @unique @db.VarChar(100)
  allowedDomains String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

model AppointmentLine {
  id              String      @id @default(cuid())
  appointmentId   String
  serviceId       String?
  serviceName     String      @db.VarChar(160)
  unitPrice       Decimal     @db.Decimal(12, 2)
  durationMinutes Int
  quantity        Int         @default(1)
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

model Invoice {
  id            String        @id @default(cuid())
  salonId       String
  invoiceNumber String        @db.VarChar(40)
  customerId    String
  appointmentId String?
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  payments      Payment[]

  @@unique([salonId, invoiceNumber])
  @@index([salonId, issuedAt])
  @@index([customerId])
}

model PayrollRun {
  id         String        @id @default(cuid())
  salonId    String
  employeeId String
  month      String        @db.VarChar(7)
  baseSalary Decimal       @db.Decimal(12, 2)
  commission Decimal       @default(0) @db.Decimal(12, 2)
  deductions Decimal       @default(0) @db.Decimal(12, 2)
  status     PayrollStatus @default(DRAFT)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  salon      Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([salonId, employeeId, month])
  @@index([salonId, month])
}

model LoyaltyEntry {
  id          String           @id @default(cuid())
  salonId     String
  customerId  String
  type        LoyaltyEntryType
  points      Int
  description String?
  createdAt   DateTime         @default(now())
  salon       Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([salonId, createdAt])
  @@index([customerId])
}

model Notification {
  id        String           @id @default(cuid())
  salonId   String
  type      NotificationType
  title     String           @db.VarChar(160)
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  salon     Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, readAt, createdAt])
}

model User {
  id                 String                  @id @default(cuid())
  salonId            String?
  name               String                  @db.VarChar(160)
  email              String?                 @unique @db.VarChar(200)
  passwordHash       String
  mustChangePassword Boolean                 @default(false)
  role               UserRole                @default(SALON_ADMIN)
  platformRoleId     String?
  twoFactorSecret    String?
  twoFactorEnabled   Boolean                 @default(false)
  active             Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  salon              Salon?                  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  sessions           Session[]
  platformRole       PlatformRole?           @relation(fields: [platformRoleId], references: [id], onDelete: SetNull)
  loginHistory       LoginHistory[]
  reportedTickets    SupportTicket[]         @relation("TicketReporter")
  assignedTickets    SupportTicket[]         @relation("TicketAssignee")
  ticketComments     SupportTicketComment[]
  bulkOperations     PlatformBulkOperation[]
  salonAuditLogs     SalonAuditLog[]

  @@index([salonId, active])
  @@index([platformRoleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  succeeded Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PlatformRole {
  id          String                   @id @default(cuid())
  code        String                   @unique @db.VarChar(60)
  name        String                   @unique @db.VarChar(100)
  description String?
  isSystem    Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  permissions PlatformRolePermission[]
  users       User[]
}

model PlatformRolePermission {
  roleId     String
  permission String       @db.VarChar(100)
  role       PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model PlatformAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(100)
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model PlatformSettings {
  id                    String   @id @default("platform")
  platformName          String   @default("DropXCutz Platform") @db.VarChar(160)
  supportEmail          String?  @db.VarChar(200)
  defaultTrialDays      Int      @default(14)
  sessionHours          Int      @default(8)
  passwordMinimumLength Int      @default(8)
  updatedAt             DateTime @updatedAt
}

model SupportTicket {
  id          String                 @id @default(cuid())
  salonId     String?
  reporterId  String?
  assigneeId  String?
  subject     String                 @db.VarChar(200)
  description String
  status      SupportTicketStatus    @default(OPEN)
  priority    SupportTicketPriority  @default(NORMAL)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  resolvedAt  DateTime?
  salon       Salon?                 @relation(fields: [salonId], references: [id], onDelete: SetNull)
  reporter    User?                  @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee    User?                  @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    SupportTicketComment[]

  @@index([status, priority, updatedAt])
  @@index([salonId, status])
  @@index([assigneeId, status])
}

model SupportTicketComment {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String?
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model TrialReminder {
  id          String   @id @default(cuid())
  salonId     String
  trialEndsAt DateTime
  reminderDay Int
  createdAt   DateTime @default(now())
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, trialEndsAt, reminderDay])
  @@index([createdAt])
}

model PlatformBulkOperation {
  id          String                      @id @default(cuid())
  actorId     String
  type        String                      @db.VarChar(100)
  status      BulkOperationStatus         @default(PENDING)
  input       Json
  result      Json?
  createdAt   DateTime                    @default(now())
  completedAt DateTime?
  actor       User                        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  items       PlatformBulkOperationItem[]

  @@index([actorId, createdAt])
  @@index([status, createdAt])
}

model PlatformBulkOperationItem {
  id          String                @id @default(cuid())
  operationId String
  salonId     String
  status      BulkOperationStatus   @default(PENDING)
  error       String?
  operation   PlatformBulkOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, salonId])
  @@index([salonId])
}

model Branch {
  id             String          @id @default(cuid())
  salonId        String
  name           String          @db.VarChar(160)
  code           String          @db.VarChar(60)
  phone          String?         @db.VarChar(30)
  email          String?         @db.VarChar(200)
  address        String?
  city           String?         @db.VarChar(100)
  state          String?         @db.VarChar(100)
  postalCode     String?         @db.VarChar(20)
  latitude       Decimal?        @db.Decimal(10, 7)
  longitude      Decimal?        @db.Decimal(10, 7)
  openingTime    String          @default("09:00") @db.VarChar(5)
  closingTime    String          @default("20:00") @db.VarChar(5)
  status         BranchStatus    @default(ACTIVE)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  salon          Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employees      Employee[]
  appointments   Appointment[]
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]
  attendance     Attendance[]
  timeSlots      TimeSlot[]

  @@unique([salonId, code])
  @@index([salonId, isActive])
}

model ServiceCategory {
  id          String    @id @default(cuid())
  salonId     String
  name        String    @db.VarChar(160)
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services    Service[]

  @@unique([salonId, name])
  @@index([salonId, isActive])
}

model EmployeeService {
  employeeId String
  serviceId  String
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
  @@index([serviceId])
}

model Supplier {
  id             String          @id @default(cuid())
  salonId        String
  name           String          @db.VarChar(160)
  contactPerson  String?         @db.VarChar(160)
  phone          String?         @db.VarChar(30)
  email          String?         @db.VarChar(200)
  gstNumber      String?         @db.VarChar(20)
  address        String?
  city           String?         @db.VarChar(100)
  state          String?         @db.VarChar(100)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  salon          Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([salonId, name])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  salonId      String
  supplierId   String
  branchId     String?
  totalAmount  Decimal             @default(0) @db.Decimal(12, 2)
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  receivedDate DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  salon        Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items        PurchaseOrderItem[]

  @@index([salonId, status])
  @@index([supplierId])
  @@index([branchId])
}

model Expense {
  id        String          @id @default(cuid())
  salonId   String
  branchId  String?
  category  ExpenseCategory
  title     String          @db.VarChar(160)
  amount    Decimal         @db.Decimal(12, 2)
  date      DateTime        @default(now())
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  salon     Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branch    Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([salonId, date])
  @@index([branchId])
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  branchId   String?
  checkIn    DateTime
  checkOut   DateTime?
  totalHours Decimal?         @db.Decimal(5, 2)
  status     AttendanceStatus @default(PRESENT)
  createdAt  DateTime         @default(now())
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch     Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([employeeId, checkIn])
  @@index([branchId, checkIn])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDate])
}

model Commission {
  id            String        @id @default(cuid())
  employeeId    String
  appointmentId String
  percentage    Decimal       @db.Decimal(5, 2)
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([employeeId, appointmentId])
  @@index([employeeId])
  @@index([appointmentId])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String?
  appointmentId String?
  customerId    String?
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PAID)
  transactionId String?       @unique @db.VarChar(160)
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([appointmentId])
  @@index([customerId])
  @@index([paidAt])
}

model MembershipPlan {
  id                 String     @id @default(cuid())
  salonId            String
  name               String     @db.VarChar(160)
  duration           Int
  price              Decimal    @db.Decimal(12, 2)
  discountPercentage Decimal    @default(0) @db.Decimal(5, 2)
  loyaltyMultiplier  Decimal    @default(1) @db.Decimal(5, 2)
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  salon              Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customers          Customer[]

  @@unique([salonId, name])
  @@index([salonId, isActive])
}

model Package {
  id              String           @id @default(cuid())
  salonId         String
  name            String           @db.VarChar(160)
  description     String?
  price           Decimal          @db.Decimal(12, 2)
  validityDays    Int
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  salon           Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  packageServices PackageService[]

  @@unique([salonId, name])
  @@index([salonId, isActive])
}

model PackageService {
  packageId String
  serviceId String
  quantity  Int     @default(1)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
  @@index([serviceId])
}

model Review {
  id            String       @id @default(cuid())
  salonId       String
  customerId    String
  appointmentId String?
  employeeId    String?
  rating        Int
  review        String?
  status        ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  salon         Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  employee      Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([salonId, createdAt])
  @@index([customerId])
  @@index([appointmentId])
  @@index([employeeId])
}

model Coupon {
  id            String     @id @default(cuid())
  salonId       String
  code          String     @db.VarChar(60)
  discountType  CouponType
  discountValue Decimal    @db.Decimal(12, 2)
  maxDiscount   Decimal?   @db.Decimal(12, 2)
  minimumOrder  Decimal    @default(0) @db.Decimal(12, 2)
  expiryDate    DateTime?
  usageLimit    Int?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  salon         Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, code])
  @@index([salonId, isActive])
  @@index([expiryDate])
}

model GalleryImage {
  id        String   @id @default(cuid())
  salonId   String
  imageUrl  String
  title     String?  @db.VarChar(160)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, order])
}

model Offer {
  id           String       @id @default(cuid())
  salonId      String
  title        String       @db.VarChar(160)
  description  String?
  bannerImage  String?
  startDate    DateTime
  endDate      DateTime
  discount     Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(PERCENTAGE)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, startDate, endDate])
}

model TimeSlot {
  id           String        @id @default(cuid())
  branchId     String
  startTime    DateTime
  endTime      DateTime
  capacity     Int           @default(1)
  isAvailable  Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([branchId, startTime])
}

model SalonSettings {
  salonId             String   @id
  invoicePrefix       String   @default("INV") @db.VarChar(12)
  currency            String   @default("INR") @db.VarChar(3)
  timezone            String   @default("Asia/Kolkata") @db.VarChar(80)
  bookingWindowDays   Int      @default(30)
  cancellationHours   Int      @default(4)
  taxPercentage       Decimal  @default(18) @db.Decimal(5, 2)
  allowOnlinePayments Boolean  @default(true)
  allowWalkIns        Boolean  @default(true)
  loyaltyEnabled      Boolean  @default(true)
  smsEnabled          Boolean  @default(false)
  whatsappEnabled     Boolean  @default(false)
  emailEnabled        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  salon               Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model SalonAuditLog {
  id        String   @id @default(cuid())
  salonId   String
  userId    String?
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(100)
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([salonId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  inventoryItemId  String
  quantity         Int
  receivedQuantity Int           @default(0)
  unitCost         Decimal       @db.Decimal(12, 2)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, inventoryItemId])
  @@index([inventoryItemId])
}
