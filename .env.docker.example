# Copy this file to .env.docker, fill in the required values, then run:
# docker compose --env-file .env.docker up --build

POSTGRES_DB=dropxcutz
POSTGRES_USER=dropxcutz
# Use a URL-safe value here (letters, numbers, hyphens, and underscores) because
# it is embedded in DATABASE_URL by Docker Compose.
POSTGRES_PASSWORD=replace-with-a-strong-database-password

PLATFORM_ADMIN_NAME=Platform Administrator
PLATFORM_ADMIN_EMAIL=owner@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional host ports (change them if they are already in use).
# POSTGRES_PORT=5432


# admin